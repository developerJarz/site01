{"nodes": [{"id": "_agents_skills_content_strategy_skill_content_strategy_skill", "label": "Content Strategy Skill", "file_type": "document", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_content_strategy_skill_product_marketing_context", "label": "Product Marketing Context (.agents/product-marketing.md)", "file_type": "concept", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read existing product marketing context first so only uncovered questions are asked."}, {"id": "_agents_skills_content_strategy_skill_treat_content_like_a_product", "label": "Treat Content Like a Product", "file_type": "rationale", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each published piece is brand surface area: a new entry point that compounds; distribution multiplies it."}, {"id": "_agents_skills_content_strategy_skill_searchable_vs_shareable", "label": "Searchable vs Shareable Content", "file_type": "rationale", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every piece must be searchable, shareable, or both; search traffic is prioritized as the foundation because it captures existing demand."}, {"id": "_agents_skills_content_strategy_skill_information_gain_gate", "label": "Information-Gain Gate", "file_type": "rationale", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't write a searchable piece unless you can state what it adds beyond current top results; otherwise neither Google nor AI assistants have reason to prefer it."}, {"id": "_agents_skills_content_strategy_skill_hub_and_spoke", "label": "Hub and Spoke Content", "file_type": "concept", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_content_strategy_skill_link_earning_formats", "label": "Link-Earning Formats", "file_type": "concept", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curated statistics roundups earn ~5x the links of original research because writers link to whatever makes citation easiest."}, {"id": "_agents_skills_content_strategy_skill_foundation_inc_backlink_report", "label": "Foundation Inc. B2B Backlink Intelligence Report (March 2026)", "file_type": "paper", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L131", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_content_strategy_skill_content_pillars_topic_clusters", "label": "Content Pillars and Topic Clusters", "file_type": "concept", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_content_strategy_skill_buyer_stage_keyword_research", "label": "Keyword Research by Buyer Stage", "file_type": "concept", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_content_strategy_skill_content_ideation_sources", "label": "Content Ideation Sources", "file_type": "concept", "source_file": ".agents/skills/content-strategy/SKILL.md", "source_location": "L229", "