{"nodes": [{"id": "_claude_skills_graphify_skill", "label": "graphify SKILL.md", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graphify_pipeline", "label": "graphify Full Pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_fast_path_existing_graph", "label": "Fast Path: Existing Graph", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When graph.json exists and the request is a natural-language question, skip rebuild steps and query the graph directly - the graph is already built."}, {"id": "_claude_skills_graphify_skill_interpreter_detection", "label": "Python Interpreter Detection (.graphify_python)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles uv tool, pipx, venv and system installs; persisted so every later step uses the same interpreter."}, {"id": "_claude_skills_graphify_skill_scan_root", "label": "Scan Root (.graphify_root)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scan path passed through a quoted heredoc rather than the command line so a malicious path cannot execute as shell code."}, {"id": "_claude_skills_graphify_skill_detect_files", "label": "Step 2 Detect Files", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_corpus_size_warning", "label": "Corpus Size Warning (>2M words / >500 files)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large corpora prompt the user to narrow to a subfolder; --no-cluster suggested when no subfolders exist."}, {"id": "_claude_skills_graphify_skill_ast_extraction", "label": "Part A Structural (AST) Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic and free; code needs no LLM or API key."}, {"id": "_claude_skills_graphify_skill_semantic_extraction", "label": "Part B Semantic Extraction (Subagents)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run in parallel with AST to save 5-15s on large corpora; only docs, papers and images go to semantic extraction (#1392)."}, {"id": "_claude_skills_graphify_skill_semantic_cache", "label": "Semantic Extraction Cache", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entries stamped with the extraction-spec prompt file so a prompt change re-extracts instead of replaying stale results (#1939)."}, {"id": "_claude_skills_graphify_skill_chunk_splitting", "label": "Chunk Splitting (20-25 files)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Group same-directory files together so cross-file relationships are more likely extracted; each image gets its own chunk."}, {"id": "_claude_skills_graphify_skill_general_purpose_subagent", "label": "General-Purpose Subagent Requirement", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explore agents are read-only and cannot write chunk files, silently dropping extraction results."}, {"id": "_claude_skills_graphify_skill_merge_ast_semantic", "label": "Part C Merge AST + Semantic", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_build_cluster_analyze", "label": "Step 4 Build, Cluster, Analyze", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_shrink_guard", "label": "Shrink Guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to overwrite graph.json with a smaller graph so an empty or partial extraction never clobbers a good graph."}, {"id": "_claude_skills_graphify_skill_graph_health_check", "label": "Step 4.5 Graph Health Check", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only diagnostic surfacing dangling/missing endpoints, self-loops and collapsed edges from incremental updates and AST/LLM id mismatches."}, {"id": "_claude_skills_graphify_skill_community_labeling", "label": "Step 5 Community Labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_html_obsidian_export", "label": "Step 6 HTML / Obsidian Export", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Obsidian is opt-in because it generates one file per node."}, {"id": "_claude_skills_graphify_skill_manifest_cost_tracker", "label": "Step 9 Manifest and Cost Tracker", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only stamp semantic files that actually produced output so a failed chunk is re-queued on the next --update (#2015)."}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent edges, always show token cost and raw cohesion scores, warn before HTML viz above 5000 nodes."}, {"id": "_claude_skills_graphify_skill_gemini_backend", "label": "Gemini Semantic Backend", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify needs no API key; Gemini is used only if GEMINI_API_KEY/GOOGLE_API_KEY is set, otherwise the host agent is the LLM."}, {"id": "_claude_skills_graphify_skill_god_nodes", "label": "God Nodes", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, 